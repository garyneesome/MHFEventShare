+    private GradientDrawable headerGradient() {
+        int lighter = blendColor(YELLOW, Color.WHITE, isDarkMode() ? 0.05f : 0.16f);
+        int deeper = blendColor(YELLOW, Color.BLACK, isDarkMode() ? 0.10f : 0.06f);
+        GradientDrawable g = new GradientDrawable(GradientDrawable.Orientation.TL_BR, new int[]{lighter, YELLOW, deeper});
+        g.setGradientType(GradientDrawable.LINEAR_GRADIENT);
+        return g;
+    }
+
+    private RippleDrawable headerControlRipple(int radiusDp) {
+        boolean lightText = HEADER_TEXT == Color.WHITE;
+        int fill = lightText ? Color.argb(38, 255, 255, 255) : Color.argb(54, 255, 255, 255);
+        int pressed = lightText ? Color.argb(74, 255, 255, 255) : Color.argb(86, 255, 255, 255);
+        GradientDrawable content = rounded(fill, fill, radiusDp);
+        return new RippleDrawable(ColorStateList.valueOf(pressed), content, null);
+    }
+
+    private int blendColor(int from, int to, float amount) {
+        float a = Math.max(0f, Math.min(1f, amount));
+        int r = Math.round(Color.red(from) * (1f - a) + Color.red(to) * a);
+        int g = Math.round(Color.green(from) * (1f - a) + Color.green(to) * a);
+        int b = Math.round(Color.blue(from) * (1f - a) + Color.blue(to) * a);
+        return Color.rgb(r, g, b);
+    }
